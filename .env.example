# Database — leave unset for local dev (embedded PGlite Postgres at ./data/pg).
# Set to a managed/self-hosted Postgres connection string in production.
# DATABASE_URL="postgres://user:password@host:5432/finance"

# Session configuration
SESSION_SECRET=generate-a-random-session-secret

# Receipt image storage — "local" (default, ./data on disk) or "s3"
# STORAGE_DRIVER=s3
# S3_BUCKET=finance-tracker-receipts
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=1                                    # MinIO/self-hosted

# AI Service Configuration (OpenAI-compatible)
# Works with OpenAI, OpenRouter, or any OpenAI-compatible endpoint
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-api-key-here
AI_MODEL=openai/gpt-5-mini

# Backend: "openrouter" (hosted, needs AI_API_KEY) or "llamacpp" (self-hosted
# llama-server, keyless — see docs/self-hosted-llm.md). Inferred when unset:
# key set → openrouter, bare AI_BASE_URL → llamacpp.
# AI_PROVIDER=openrouter

# Set to 1 for testing with mock responses (no real API calls)
# AI_FAKE=1

# AI cost controls (see docs/self-hosted-llm.md and features/105)
# Receipt scans per user per calendar month (default 10)
# AI_FREE_SCANS_PER_MONTH=10
# Global daily spend circuit breaker for the hosted backend, in USD.
# Unset = no cap (e.g. pure self-hosted deployments). Warns at 80%.
# AI_DAILY_SPEND_CAP_USD=5

# Plan limits
# Category budgets a free-plan user may create (default 3; Pro is unlimited)
# BILLING_FREE_MAX_BUDGETS=3

# Observability
# Error tracking (Sentry or GlitchTip). Unset = disabled.
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# Log verbosity: fatal | error | warn | info (default) | debug | trace
# LOG_LEVEL=info
